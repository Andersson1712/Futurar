# Backend Environment Variables

# Server Port
PORT=3001

# Supabase (backend-only service access). Required to authenticate AI requests
# when AI_ENDPOINTS_ENABLED=true; never expose SERVICE_KEY to the frontend.
SUPABASE_URL=https://twlnvsznmljezvzbpqrj.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# AI configuration lives ONLY on the backend. NEVER expose keys to the frontend.
# When AI_ENDPOINTS_ENABLED=true, GEMINI_API_KEY, SUPABASE_URL and
# SUPABASE_SERVICE_KEY are all required (boot fails otherwise).
GEMINI_API_KEY=your_gemini_key_here
AI_PROVIDER=gemini

# Stable Gemini models (validated 2026-09; see docs/specs/SPEC-002.md)
AI_MODEL_TEXT=gemini-3.8-flash
AI_MODEL_IMAGE=gemini-3.1-flash-image
AI_MODEL_TTS=gemini-3.8-flash-tts

# Gemini TTS has no es-AR support yet: es-419 (preview) is the default.
AI_TTS_VOICE=Kore
AI_TTS_LANGUAGE=es-419

# POST /ai/* endpoints stay disabled until the pipeline lands (SPEC-004/005/006).
AI_ENDPOINTS_ENABLED=false

# OpenAPI docs at /api/v1/docs (default: enabled outside production).
SWAGGER_ENABLED=true

# Global rate limiting; POST /ai/books/generate is limited to 5/min.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Generation queue: "bullmq" (Redis) or "inline" (no Redis, dev/CI).
# Defaults to bullmq when REDIS_URL is set, inline otherwise.
QUEUE_DRIVER=inline
# REDIS_URL=redis://localhost:6379

# Job persistence uses Supabase when SUPABASE_URL/SERVICE_KEY are configured;
# apply backend/supabase/migrations/0001_generation_jobs.sql first.

# Book persistence: apply 0002_books.sql. Page images are optional and stored
# in a private bucket (create it manually); reads mint signed URLs.
BOOK_IMAGES_ENABLED=false
BOOK_IMAGE_BUCKET=book-images
BOOK_IMAGE_SIGNED_URL_TTL_SECONDS=3600

# Per-teacher credentials (SPEC-020). When enabled, apply 0004_ai_credentials.sql
# and set AI_SECRETS_MASTER_KEY to a base64-encoded 32-byte key:
#   openssl rand -base64 32
# The stored key wins over GEMINI_API_KEY; the env key stays as dev fallback.
AI_CREDENTIALS_ENABLED=false
# AI_SECRETS_MASTER_KEY=replace-with-base64-32-bytes
