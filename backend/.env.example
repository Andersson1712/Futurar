# Backend Environment Variables

# Server Port
PORT=3001

# Supabase (opcional, para acceso directo desde backend)
SUPABASE_URL=https://twlnvsznmljezvzbpqrj.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# AI provider keys live ONLY on the backend. NEVER expose them to the frontend.
GEMINI_API_KEY=your_gemini_key_here

# AI POST endpoints (/ai/story, /ai/image, /ai/validate-key) are disabled by
# default while server-side key handling and validation are migrated (SPEC-002/003).
# Set to "true" only after those specs land.
AI_ENDPOINTS_ENABLED=false
